# ===========================================
# DEPLOYMENT CREDENTIALS (LOCAL ONLY)
# These are used by Serverless Framework to deploy
# They are NOT sent to Lambda functions
# ===========================================
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_access_key_here
AWS_DEFAULT_REGION=us-east-1
SERVERLESS_ACCESS_KEY=your_serverless_access_key_here

# ===========================================
# APPLICATION ENVIRONMENT VARIABLES
# These WILL be passed to Lambda functions
# Only add variables your Lambda needs
# ===========================================
NODE_ENV=development
API_VERSION=v1

# Example database URL (uncomment if needed)
# DB_URL=mongodb://localhost:27017/myapp

# Example API keys (uncomment if needed)
# EXTERNAL_API_KEY=your-api-key-here