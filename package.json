{
  "name": "deploy",
  "version": "1.0.0",
  "description": "Serverless application with environment-based AWS credentials",
  "scripts": {
    "prestart": "node -e \"require('dotenv').config()\"",
    "deploy": "dotenv -- serverless deploy",
    "deploy:dev": "dotenv -- serverless deploy --stage dev",
    "deploy:prod": "dotenv -- serverless deploy --stage prod",
    "remove": "dotenv -- serverless remove",
    "info": "dotenv -- serverless info",
    "logs": "dotenv -- serverless logs",
    "dev": "dotenv -- serverless offline",
    "offline": "dotenv -- serverless offline",
    "start": "npm run dev",
    "test": "curl http://localhost:3001/",
    "test:health": "curl http://localhost:3001/health",
    "test:user-profile": "curl http://localhost:3001/user/profile",
    "test:user-settings": "curl http://localhost:3001/user/settings",
    "test:auth-login": "curl -X POST http://localhost:3001/auth/login -H \"Content-Type: application/json\" -d \"{}\"",
    "test:auth-register": "curl -X POST http://localhost:3001/auth/register -H \"Content-Type: application/json\" -d \"{}\"",
    "package": "dotenv -- serverless package",
    "package-info": "dotenv -- serverless print"
  },
  "dependencies": {
    "express": "^4.19.2",
    "serverless-http": "^3.2.0"
  },
  "devDependencies": {
    "dotenv": "^17.2.3",
    "dotenv-cli": "^11.0.0",
    "serverless-offline": "^14.4.0"
  }
}
